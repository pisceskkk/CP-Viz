      "text": "1 · PCP Decode 两种请求调度模式",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 · PCP Decode 两种请求调度模式",
      "autoResize": true,
      "lineHeight": 1.28
    },
    {
