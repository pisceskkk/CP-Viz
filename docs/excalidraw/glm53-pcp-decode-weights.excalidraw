    {
      "type": "text",
      "id": "dec_rep_t",
      "x": 65,
      "y": 258,
      "width": 455,
      "height": 119,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
